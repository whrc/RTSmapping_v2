# Data-preparation image — Earth Engine + the geo stack, no CUDA, no torch.
#
# Why a second image: the EXTRA-channel generator (scripts/generate_extra_tiles.py)
# and the ArcticDEM diagnostic (scripts/arcticdem_diagnostic.py) need
# earthengine-api, which the training image does not carry. Rebuilding
# Dockerfile.train to add it is not an option mid-campaign: requirements.txt uses
# `>=` ranges, so a rebuild would float torch/albumentations and break numeric
# comparability with the runs already in the ledger. Data prep never touches
# training numerics, so it gets its own small image instead.
#
# Dependency versions are the same floors as requirements.txt (CLAUDE Rule 5) —
# this file installs a subset of it, it does not introduce new dependencies.
#
# Build:
#   sudo docker build -f computing/Dockerfile.dataprep -t rts-dataprep:v1 .
# Run (GEE via ADC, repo bind-mounted):
#   sudo docker run --rm --entrypoint python \
#     -v "$PWD":/app -v /mnt/outputs:/outputs \
#     -v $HOME/.config/gcloud:/root/.config/gcloud:ro -w /app \
#     rts-dataprep:v1 scripts/generate_extra_tiles.py --help

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        "rasterio>=1.3" \
        "geopandas>=0.14" \
        "shapely>=2.0" \
        "pyproj>=3.6" \
        "numpy>=1.26" \
        "pandas>=2.1" \
        "scipy>=1.11" \
        "google-cloud-storage>=2.14" \
        "earthengine-api>=1.0" \
        "pyyaml>=6.0" \
        "tqdm>=4.66"

WORKDIR /app
